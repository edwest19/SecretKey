<?xml version="1.0" encoding="utf-8"?>

<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <!--
    AI-generated (Claude): Publisher is the exact name the Artifact Signing certificate
    (account edwest19, profile CodeSigning-Apps) signs as. It is case-sensitive ("S=ny"),
    must equal EXPECTED_SIGNER in .github/workflows/release.yml, and is checked by
    ReleaseRulesTests. Version is Directory.Build.props' Version plus ".0".
  -->
  <Identity
    Name="d3e8fa94-4e8c-4c91-a5d9-a3c738d9cd26"
    Publisher="CN=Edwin West, O=Edwin West, L=Huntington, S=ny, C=US"
    Version="2.0.0.0" />

  <mp:PhoneIdentity PhoneProductId="d3e8fa94-4e8c-4c91-a5d9-a3c738d9cd26" PhonePublisherId="00000000-0000-0000-0000-000000000000"/>

  <Properties>
    <DisplayName>SecretKey</DisplayName>
    <PublisherDisplayName>Edwin West</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26226.0" />
  </Dependencies>

  <Resources>
    <Resource Language="x-generate"/>
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="SecretKey"
        Description="Stateless, deterministic password generator"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Only runFullTrust: no network, device or AI capabilities (enforced by RepositoryRulesTests).
         The unused systemAIModels capability was removed by Claude (Anthropic). -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
