<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecretKey.Core\SecretKey.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The repo's sample input, copied next to the tests so its passwords are locked too. -->
    <None Include="..\sample_input.csv" Link="TestData\sample_input.csv" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
